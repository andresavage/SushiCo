{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve-site",
      "type": "shell",
      "command": "python3 -m http.server 8080",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "http",
        "pattern": { "regexp": ".", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP"
        }
      }
    }
  ]
}
